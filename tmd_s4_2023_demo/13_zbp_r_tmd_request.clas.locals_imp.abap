*"* Behavior implementation of ZR_TMD_REQUEST - "Local Types" tab of ZBP_R_TMD_REQUEST
*"* (The global class itself is generated by ADT: CLASS zbp_r_tmd_request DEFINITION
*"*  PUBLIC ABSTRACT FINAL FOR BEHAVIOR OF zr_tmd_request. ENDCLASS. ...)
*"*
*"* Flow on the screen:
*"*   Create        -> setDefaults (US, Street Number, increment 1 ...)
*"*   Pick mode     -> setMode -> side effect hides/shows fields
*"*   Pick ref CO/Premise -> fillFromReference -> address fields filled
*"*   Replicate     -> generateTargets: address generator + duplicate checks
*"*   Save          -> validateHeader, setRequestID
*"*   Create Objects-> execute: demo engine; saver writes ZTMD_OBJ
*"* No COMMIT / ROLLBACK anywhere (RAP transactional contract).

CLASS lcl_status DEFINITION FINAL.
  PUBLIC SECTION.
    CONSTANTS: new       TYPE c LENGTH 1 VALUE 'N',
               generated TYPE c LENGTH 1 VALUE 'G',   " rows generated, some rows have errors
               ready     TYPE c LENGTH 1 VALUE 'S',   " rows generated and checked: ready to create
               created   TYPE c LENGTH 1 VALUE 'C'.
    TYPES: BEGIN OF ty_status,
             status TYPE c LENGTH 1,
             text   TYPE c LENGTH 30,
             crit   TYPE int1,
           END OF ty_status.
    CLASS-METHODS get IMPORTING iv_status        TYPE c
                      RETURNING VALUE(rs_status) TYPE ty_status.
ENDCLASS.

CLASS lcl_status IMPLEMENTATION.
  METHOD get.
    rs_status = SWITCH #( iv_status
      WHEN new       THEN VALUE #( status = new       text = 'New'                     crit = 0 )
      WHEN generated THEN VALUE #( status = generated text = 'Check rows'              crit = 2 )
      WHEN ready     THEN VALUE #( status = ready     text = 'Ready - save and create' crit = 2 )
      WHEN created   THEN VALUE #( status = created   text = 'Objects created'         crit = 3 ) ).
  ENDMETHOD.
ENDCLASS.


"! Transactional buffer for the demo objects; written by the saver in the save phase
CLASS lcl_buffer DEFINITION FINAL.
  PUBLIC SECTION.
    CLASS-DATA mt_objects TYPE zcl_tmd_demo_engine=>tt_object.
ENDCLASS.

CLASS lcl_buffer IMPLEMENTATION.
ENDCLASS.


CLASS lhc_request DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    TYPES tt_request    TYPE TABLE FOR READ RESULT zr_tmd_request\\Request.
    TYPES tt_target     TYPE TABLE FOR READ RESULT zr_tmd_request\\Target.
    TYPES tt_target_upd TYPE TABLE FOR UPDATE zr_tmd_request\\Target.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR Request RESULT result.

    METHODS get_instance_features FOR INSTANCE FEATURES
      IMPORTING keys REQUEST requested_features FOR Request RESULT result.

    METHODS setdefaults FOR DETERMINE ON MODIFY
      IMPORTING keys FOR Request~setDefaults.

    METHODS setmode FOR DETERMINE ON MODIFY
      IMPORTING keys FOR Request~setMode.

    METHODS fillfromreference FOR DETERMINE ON MODIFY
      IMPORTING keys FOR Request~fillFromReference.

    METHODS setrequestid FOR DETERMINE ON SAVE
      IMPORTING keys FOR Request~setRequestID.

    METHODS validateheader FOR VALIDATE ON SAVE
      IMPORTING keys FOR Request~validateHeader.

    METHODS generatetargets FOR MODIFY
      IMPORTING keys FOR ACTION Request~generateTargets RESULT result.

    METHODS execute FOR MODIFY
      IMPORTING keys FOR ACTION Request~execute RESULT result.

    "! Duplicate checks against the (simulated) master data - spec negative tests 3 and 4
    METHODS check_targets
      IMPORTING it_request    TYPE tt_request
                it_target     TYPE tt_target
      RETURNING VALUE(rt_upd) TYPE tt_target_upd.
ENDCLASS.


CLASS lhc_request IMPLEMENTATION.

  METHOD get_global_authorizations.
    " DEMO: everybody may do everything.
    " Production: AUTHORITY-CHECK OBJECT 'ZTMD_REQ' ID 'ACTVT' FIELD '01' ... per operation.
    result = VALUE #( %create                 = if_abap_behv=>auth-allowed
                      %update                 = if_abap_behv=>auth-allowed
                      %delete                 = if_abap_behv=>auth-allowed
                      %action-generateTargets = if_abap_behv=>auth-allowed
                      %action-execute         = if_abap_behv=>auth-allowed ).
  ENDMETHOD.


  METHOD get_instance_features.
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request FIELDS ( Status ) WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req)
      FAILED failed.

    result = VALUE #( FOR r IN lt_req
      LET is_draft = xsdbool( r-%is_draft = if_abap_behv=>mk-on )
          done     = xsdbool( r-Status = lcl_status=>created )
          lv_on    = if_abap_behv=>fc-o-enabled
          lv_off   = if_abap_behv=>fc-o-disabled IN
      ( %tky                    = r-%tky
        %update                 = COND #( WHEN done = abap_true THEN lv_off ELSE lv_on )
        %delete                 = COND #( WHEN done = abap_true THEN lv_off ELSE lv_on )
        %action-Edit            = COND #( WHEN done = abap_true THEN lv_off ELSE lv_on )
        " Replicate: only while editing
        %action-generateTargets = COND #( WHEN is_draft = abap_true AND done = abap_false THEN lv_on ELSE lv_off )
        " Create Objects: only on the saved request, after a clean Replicate
        %action-execute         = COND #( WHEN is_draft = abap_false AND r-Status = lcl_status=>ready
                                          THEN lv_on ELSE lv_off ) ) ).
  ENDMETHOD.


  METHOD setdefaults.
    DATA(ls_new) = lcl_status=>get( lcl_status=>new ).
    MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request
        UPDATE FIELDS ( Country ReplicateMode IsStreetMode IsApartmentMode IncrementValue IncrementBy
                        LetterNumberFormat StartLetter StartNumber KeyDate
                        Status StatusText StatusCriticality )
        WITH VALUE #( FOR k IN keys ( %tky               = k-%tky
                                      Country            = 'US'
                                      ReplicateMode      = 'S'
                                      IsStreetMode       = abap_true
                                      IsApartmentMode    = abap_false
                                      IncrementValue     = 1
                                      IncrementBy        = 'N'
                                      LetterNumberFormat = 'A1'
                                      StartLetter        = 'A'
                                      StartNumber        = 1
                                      KeyDate            = cl_abap_context_info=>get_system_date( )
                                      Status             = ls_new-status
                                      StatusText         = ls_new-text
                                      StatusCriticality  = ls_new-crit ) ).
  ENDMETHOD.


  METHOD setmode.
    " Boolean flags read by  hidden: #(IsStreetMode)  /  hidden: #(IsApartmentMode)
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request FIELDS ( ReplicateMode ) WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req).

    MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request
        UPDATE FIELDS ( IsStreetMode IsApartmentMode )
        WITH VALUE #( FOR r IN lt_req ( %tky            = r-%tky
                                        IsStreetMode    = xsdbool( r-ReplicateMode <> 'A' )
                                        IsApartmentMode = xsdbool( r-ReplicateMode =  'A' ) ) ).
  ENDMETHOD.


  METHOD fillfromreference.
    " Spec business logic steps 1-3: reference Premise or Connection Object -> address on screen.
    " DEMO: reads the simulated objects. On 2025: I_UtilitiesPremise / I_UtilsTechObjLocationAddr.
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request FIELDS ( RefPremise RefConnectionObject IsApartmentMode ) WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req).

    LOOP AT lt_req ASSIGNING FIELD-SYMBOL(<ls_req>).
      DATA(lv_co) = <ls_req>-RefConnectionObject.

      IF <ls_req>-RefPremise IS NOT INITIAL.
        SELECT SINGLE FROM ztmd_obj
          FIELDS parent_co
          WHERE object_type = 'PREM' AND object_id = @<ls_req>-RefPremise
          INTO @DATA(lv_parent_co).
        IF sy-subrc <> 0.
          APPEND VALUE #( %tky                = <ls_req>-%tky
                          %msg                = new_message( id       = 'ZTMD'
                                                             number   = '001'
                                                             v1       = <ls_req>-RefPremise
                                                             severity = if_abap_behv_message=>severity-error )
                          %element-RefPremise = if_abap_behv=>mk-on ) TO reported-request.
          CONTINUE.
        ENDIF.
        lv_co = lv_parent_co.
      ENDIF.

      IF lv_co IS INITIAL.
        CONTINUE.
      ENDIF.

      SELECT SINGLE FROM ztmd_obj
        FIELDS house_number, street, city_name, postal_code, region, country
        WHERE object_type = 'CO' AND object_id = @lv_co
        INTO @DATA(ls_co).
      IF sy-subrc <> 0.
        APPEND VALUE #( %tky                         = <ls_req>-%tky
                        %msg                         = new_message( id       = 'ZTMD'
                                                                    number   = '001'
                                                                    v1       = lv_co
                                                                    severity = if_abap_behv_message=>severity-error )
                        %element-RefConnectionObject = if_abap_behv=>mk-on ) TO reported-request.
        CONTINUE.
      ENDIF.

      MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
        ENTITY Request
          UPDATE FIELDS ( RefConnectionObject ReuseConnectionObject HouseNumber StreetName
                          CityName PostalCode Region Country )
          WITH VALUE #( ( %tky                  = <ls_req>-%tky
                          RefConnectionObject   = lv_co
                          " apartment complex: new premises go under the reference CO
                          ReuseConnectionObject = <ls_req>-IsApartmentMode
                          HouseNumber           = ls_co-house_number
                          StreetName            = ls_co-street
                          CityName              = ls_co-city_name
                          PostalCode            = ls_co-postal_code
                          Region                = ls_co-region
                          Country               = ls_co-country ) ).
    ENDLOOP.
  ENDMETHOD.


  METHOD setrequestid.
    " DEMO numbering. Production: number range object via CL_NUMBERRANGE_RUNTIME.
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request FIELDS ( RequestID ) WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req).
    DELETE lt_req WHERE RequestID IS NOT INITIAL.
    IF lt_req IS INITIAL.
      RETURN.
    ENDIF.

    SELECT MAX( request_id ) FROM ztmd_req INTO @DATA(lv_max).
    DATA(lv_next) = CONV i( lv_max ).

    MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request
        UPDATE FIELDS ( RequestID )
        WITH VALUE #( FOR r IN lt_req INDEX INTO i
                      ( %tky = r-%tky  RequestID = lv_next + i ) ).
  ENDMETHOD.


  METHOD validateheader.
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req).

    LOOP AT lt_req INTO DATA(ls_req).
      " clear old messages of this validation
      APPEND VALUE #( %tky = ls_req-%tky %state_area = 'HEADER' ) TO reported-request.

      IF ls_req-ScenarioID IS INITIAL.
        APPEND VALUE #( %tky = ls_req-%tky ) TO failed-request.
        APPEND VALUE #( %tky                = ls_req-%tky
                        %state_area         = 'HEADER'
                        %msg                = new_message( id = 'ZTMD' number = '020' v1 = '?'
                                                           severity = if_abap_behv_message=>severity-error )
                        %element-ScenarioID = if_abap_behv=>mk-on ) TO reported-request.
      ENDIF.

      IF ls_req-NumberOfObjects <= 0.                                         " negative tests 5, 6
        APPEND VALUE #( %tky = ls_req-%tky ) TO failed-request.
        APPEND VALUE #( %tky                     = ls_req-%tky
                        %state_area              = 'HEADER'
                        %msg                     = new_message( id = 'ZTMD' number = '011' v1 = 999
                                                                severity = if_abap_behv_message=>severity-error )
                        %element-NumberOfObjects = if_abap_behv=>mk-on ) TO reported-request.
      ENDIF.

      IF ls_req-IncrementValue <= 0.                                          " negative tests 7, 8
        APPEND VALUE #( %tky = ls_req-%tky ) TO failed-request.
        APPEND VALUE #( %tky                    = ls_req-%tky
                        %state_area             = 'HEADER'
                        %msg                    = new_message( id = 'ZTMD' number = '014'
                                                               severity = if_abap_behv_message=>severity-error )
                        %element-IncrementValue = if_abap_behv=>mk-on ) TO reported-request.
      ENDIF.

      IF ls_req-MaintenancePlant IS NOT INITIAL.
        " real MM data: plant must exist (released view I_Plant)
        SELECT SINGLE FROM i_plant FIELDS Plant WHERE Plant = @ls_req-MaintenancePlant INTO @DATA(lv_plant).
        IF sy-subrc <> 0.
          APPEND VALUE #( %tky = ls_req-%tky ) TO failed-request.
          APPEND VALUE #( %tky                      = ls_req-%tky
                          %state_area               = 'HEADER'
                          %msg                      = new_message( id = 'ZTMD' number = '026'
                                                                   v1 = ls_req-MaintenancePlant
                                                                   severity = if_abap_behv_message=>severity-error )
                          %element-MaintenancePlant = if_abap_behv=>mk-on ) TO reported-request.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD generatetargets.
    " "Replicate" button: scenario + address generator -> target rows -> duplicate checks
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req)
      ENTITY Request BY \_Target FIELDS ( TargetUUID ) WITH CORRESPONDING #( keys )
      RESULT DATA(lt_old_rows).

    " remove rows of an earlier Replicate (user changed the parameters)
    IF lt_old_rows IS NOT INITIAL.
      MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
        ENTITY Target DELETE FROM VALUE #( FOR o IN lt_old_rows ( %tky = o-%tky ) ).
    ENDIF.

    DATA lt_failed_uuid TYPE STANDARD TABLE OF sysuuid_x16 WITH EMPTY KEY.

    DATA(lo_generator) = NEW zcl_tmd_address_generator( ).

    LOOP AT lt_req INTO DATA(ls_req).
      TRY.
          SELECT SINGLE FROM zi_tmd_scenario
            FIELDS MaxRowsTotal
            WHERE ScenarioID = @ls_req-ScenarioID
            INTO @DATA(lv_max_rows).
          IF sy-subrc <> 0.
            RAISE EXCEPTION TYPE zcx_tmd MESSAGE e020(ztmd) WITH ls_req-ScenarioID.
          ENDIF.
          IF ls_req-NumberOfObjects > lv_max_rows.
            RAISE EXCEPTION TYPE zcx_tmd MESSAGE e021(ztmd) WITH lv_max_rows.
          ENDIF.

          DATA(lt_rows) = lo_generator->generate( VALUE #(
                            mode                 = ls_req-ReplicateMode
                            number_of_objects    = ls_req-NumberOfObjects
                            house_number         = condense( ls_req-HouseNumber )
                            increment_value      = ls_req-IncrementValue
                            increment_by         = ls_req-IncrementBy
                            street_direction     = ls_req-StreetDirection
                            street_name          = ls_req-StreetName
                            street_suffix        = ls_req-StreetSuffix
                            unit_type            = ls_req-UnitType
                            letter_number_format = ls_req-LetterNumberFormat
                            start_letter         = ls_req-StartLetter
                            start_number         = ls_req-StartNumber ) ).

          MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
            ENTITY Request
              CREATE BY \_Target
              FIELDS ( GroupNo SeqNo HouseNumber Street Supplement StreetSupplement PremiseType )
              WITH VALUE #( ( %tky    = ls_req-%tky
                              %target = VALUE #( FOR row IN lt_rows INDEX INTO idx
                                                 ( %cid             = |T{ idx }|
                                                   %is_draft        = ls_req-%is_draft
                                                   GroupNo          = row-group_no
                                                   SeqNo            = row-seq_no
                                                   HouseNumber      = row-house_number
                                                   Street           = row-street
                                                   Supplement       = row-supplement
                                                   StreetSupplement = ls_req-StreetSupplement
                                                   PremiseType      = ls_req-PremiseType ) ) ) ).

        CATCH zcx_tmd INTO DATA(lx_error).
          APPEND VALUE #( %tky = ls_req-%tky ) TO failed-request.
          APPEND VALUE #( %tky = ls_req-%tky %msg = lx_error ) TO reported-request.
          APPEND ls_req-RequestUUID TO lt_failed_uuid.   " no rows for this request -> skip the checks
      ENDTRY.
    ENDLOOP.

    LOOP AT lt_failed_uuid INTO DATA(lv_failed_uuid).
      DELETE lt_req WHERE RequestUUID = lv_failed_uuid.
    ENDLOOP.

    IF lt_req IS NOT INITIAL.
      " read the new rows back (they are in the transactional buffer) and check them
      READ ENTITIES OF zr_tmd_request IN LOCAL MODE
        ENTITY Request BY \_Target ALL FIELDS WITH CORRESPONDING #( lt_req )
        RESULT DATA(lt_new_rows).

      DATA(lt_upd) = check_targets( it_request = lt_req it_target = lt_new_rows ).

      MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
        ENTITY Target
          UPDATE FIELDS ( RowStatus RowMessage RowCriticality ) WITH lt_upd
        ENTITY Request
          UPDATE FIELDS ( Status StatusText StatusCriticality )
          WITH VALUE #( FOR r IN lt_req
                        LET has_error = xsdbool( line_exists( lt_upd[ RequestUUID = r-RequestUUID RowStatus = 'E' ] ) )
                            st        = lcl_status=>get( COND #( WHEN has_error = abap_true THEN lcl_status=>generated
                                                                 ELSE lcl_status=>ready ) ) IN
                        ( %tky              = r-%tky
                          Status            = st-status
                          StatusText        = st-text
                          StatusCriticality = st-crit ) ).
    ENDIF.

    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_result).
    result = VALUE #( FOR res IN lt_result ( %tky = res-%tky %param = res ) ).
  ENDMETHOD.


  METHOD check_targets.
    LOOP AT it_target INTO DATA(ls_tgt).
      DATA(ls_req) = VALUE #( it_request[ RequestUUID = ls_tgt-RequestUUID ] OPTIONAL ).
      DATA(lv_msg) = VALUE string( ).

      IF ls_req-ReuseConnectionObject = abap_true AND ls_req-RefConnectionObject IS NOT INITIAL.
        " Apartment complex under an existing CO: same supplement must not exist (negative test 4)
        SELECT SINGLE FROM ztmd_obj FIELDS object_id
          WHERE object_type = 'PREM'
            AND parent_co   = @ls_req-RefConnectionObject
            AND supplement  = @ls_tgt-Supplement
          INTO @DATA(lv_premise).
        IF sy-subrc = 0.
          MESSAGE e022(ztmd) WITH lv_premise ls_tgt-Supplement INTO lv_msg.
        ENDIF.
      ELSEIF ls_tgt-SeqNo = 1 OR ls_req-ReplicateMode = 'S'.
        " New Connection Object: same house number + street + postal code must not exist (negative test 3)
        SELECT SINGLE FROM ztmd_obj FIELDS object_id
          WHERE object_type  = 'CO'
            AND house_number = @ls_tgt-HouseNumber
            AND street       = @ls_tgt-Street
            AND postal_code  = @ls_req-PostalCode
          INTO @DATA(lv_co).
        IF sy-subrc = 0.
          MESSAGE e023(ztmd) WITH lv_co INTO lv_msg.
        ENDIF.
      ENDIF.

      APPEND VALUE #( %tky           = ls_tgt-%tky
                      RequestUUID    = ls_tgt-RequestUUID   " not updated (not in FIELDS), used for the status check
                      RowStatus      = COND #( WHEN lv_msg IS INITIAL THEN ' ' ELSE 'E' )
                      RowCriticality = COND #( WHEN lv_msg IS INITIAL THEN 0 ELSE 1 )
                      RowMessage     = COND #( WHEN lv_msg IS INITIAL THEN 'OK - will be created' ELSE lv_msg ) )
             TO rt_upd.
    ENDLOOP.
  ENDMETHOD.


  METHOD execute.
    " "Create Objects": runs on the SAVED request. DEMO: synchronous demo engine.
    " Production (2025): set status 'Queued' here and start a bgPF process in the saver;
    " the bgPF operation calls the released Utilities RAP BOs (see design doc).
    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_req)
      ENTITY Request BY \_Target ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_tgt).

    DATA(lo_engine)  = NEW zcl_tmd_demo_engine( ).
    DATA(ls_created) = lcl_status=>get( lcl_status=>created ).
    DATA lt_upd TYPE tt_target_upd.

    LOOP AT lt_req INTO DATA(ls_req).
      SELECT SINGLE FROM zi_tmd_scenario
        FIELDS ElectricFlag, GasFlag, LightFlag
        WHERE ScenarioID = @ls_req-ScenarioID
        INTO @DATA(ls_scen).

      DATA(lt_rows) = VALUE zcl_tmd_demo_engine=>tt_row(
                        FOR t IN lt_tgt WHERE ( RequestUUID = ls_req-RequestUUID )
                        ( target_uuid  = t-TargetUUID
                          group_no     = t-GroupNo
                          house_number = t-HouseNumber
                          street       = t-Street
                          supplement   = t-Supplement ) ).
      SORT lt_rows BY group_no.

      lo_engine->create_objects(
        EXPORTING is_request = VALUE #( request_uuid = ls_req-RequestUUID
                                        ref_co       = ls_req-RefConnectionObject
                                        reuse_co     = ls_req-ReuseConnectionObject
                                        city_name    = ls_req-CityName
                                        postal_code  = ls_req-PostalCode
                                        region       = ls_req-Region
                                        country      = ls_req-Country
                                        plant        = ls_req-MaintenancePlant
                                        electric     = ls_scen-ElectricFlag
                                        gas          = ls_scen-GasFlag
                                        light        = ls_scen-LightFlag )
        CHANGING  ct_rows    = lt_rows
                  ct_objects = lcl_buffer=>mt_objects ).

      LOOP AT lt_rows INTO DATA(ls_row).
        APPEND VALUE #( %is_draft        = if_abap_behv=>mk-off
                        TargetUUID       = ls_row-target_uuid
                        ConnectionObject = ls_row-connection_object
                        Premise          = ls_row-premise
                        DevLocElectric   = ls_row-devloc_electric
                        DevLocGas        = ls_row-devloc_gas
                        DevLocLight      = ls_row-devloc_light
                        RowStatus        = ls_row-row_status
                        RowMessage       = ls_row-row_message
                        RowCriticality   = ls_row-row_criticality ) TO lt_upd.
      ENDLOOP.
    ENDLOOP.

    MODIFY ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Target
        UPDATE FIELDS ( ConnectionObject Premise DevLocElectric DevLocGas DevLocLight
                        RowStatus RowMessage RowCriticality ) WITH lt_upd
      ENTITY Request
        UPDATE FIELDS ( Status StatusText StatusCriticality )
        WITH VALUE #( FOR r IN lt_req ( %tky              = r-%tky
                                        Status            = ls_created-status
                                        StatusText        = ls_created-text
                                        StatusCriticality = ls_created-crit ) ).

    " success toast in Fiori: "&1 objects created"
    APPEND new_message( id = 'ZTMD' number = '025' v1 = lines( lcl_buffer=>mt_objects )
                        severity = if_abap_behv_message=>severity-success ) TO reported-%other.

    READ ENTITIES OF zr_tmd_request IN LOCAL MODE
      ENTITY Request ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_result).
    result = VALUE #( FOR res IN lt_result ( %tky = res-%tky %param = res ) ).
  ENDMETHOD.

ENDCLASS.


"! Saver: writes the demo objects in the save phase (the only place RAP allows DB writes)
CLASS lsc_zr_tmd_request DEFINITION INHERITING FROM cl_abap_behavior_saver.
  PROTECTED SECTION.
    METHODS save_modified REDEFINITION.
    METHODS cleanup_finalize REDEFINITION.
ENDCLASS.

CLASS lsc_zr_tmd_request IMPLEMENTATION.

  METHOD save_modified.
    IF lcl_buffer=>mt_objects IS NOT INITIAL.
      INSERT ztmd_obj FROM TABLE @lcl_buffer=>mt_objects.
      CLEAR lcl_buffer=>mt_objects.
    ENDIF.
  ENDMETHOD.

  METHOD cleanup_finalize.
    CLEAR lcl_buffer=>mt_objects.
  ENDMETHOD.

ENDCLASS.
